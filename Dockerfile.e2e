# Dockerfile.e2e — prebuilt harness images for CI (NEV-59 review fix §3).
#
# `go run` inside compose services re-downloads + recompiles on every CI run
# and never became ready in time. These images compile once at
# `docker compose build` (with module layer caching) and start instantly.
# PKG selects the binary: ./cmd/paylessforai-app or ./cmd/mockprovider.
# The final image carries curl for compose healthchecks.

ARG GO_IMAGE=golang:1.26-bookworm

FROM ${GO_IMAGE} AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . ./
ARG PKG=./cmd/paylessforai-app
RUN CGO_ENABLED=0 go build -o /out/service ${PKG}

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates \
  && rm -rf /var/lib/apt/lists/*
COPY --from=build /out/service /usr/local/bin/service
ENTRYPOINT ["/usr/local/bin/service"]
